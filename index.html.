// SCRIPT UNIFICADO PARA cumpleIGHO (Google Sheets + Sincronización + Alertas)
// ============================================================================
const CORREOS_ALERTA = "admin@ejemplo.com, segundo@ejemplo.com"; // Separa con coma si son varios

// 1. RECIBE NUEVOS REGISTROS DESDE EL FORMULARIO WEB (POST)
function doPost(e) {
  try {
    const hoja = SpreadsheetApp.getActiveSpreadsheet().getActiveSheet();
    const datos = JSON.parse(e.postData.contents);
    const nombre = (datos.firstName || "").trim();
    const apellido = (datos.lastName || "").trim();
    const fechaNacimiento = (datos.dob || "").trim(); // Formato AAAA-MM-DD

    if (!nombre || !apellido || !fechaNacimiento) {
      return ContentService.createTextOutput(JSON.stringify({ status: "error", message: "Datos incompletos" }))
        .setMimeType(ContentService.MimeType.JSON);
    }

    hoja.appendRow([nombre, apellido, fechaNacimiento]);

    return ContentService.createTextOutput(JSON.stringify({ status: "ok" }))
      .setMimeType(ContentService.MimeType.JSON);
  } catch (err) {
    return ContentService.createTextOutput(JSON.stringify({ status: "error", message: err.toString() }))
      .setMimeType(ContentService.MimeType.JSON);
  }
}

// 2. DEVUELVE TODOS LOS CUMPLEAÑOS AL CALENDARIO WEB (GET)
function doGet(e) {
  const hoja = SpreadsheetApp.getActiveSpreadsheet().getActiveSheet();
  const filas = hoja.getDataRange().getValues();
  const registros = [];

  for (let i = 1; i &lt; filas.length; i++) {
    const [nombre, apellido, fechaRaw] = filas[i];
    if (!nombre || !apellido || !fechaRaw) continue;

    let dobIso = "";
    if (fechaRaw instanceof Date) {
      dobIso = Utilities.formatDate(fechaRaw, Session.getScriptTimeZone(), "yyyy-MM-dd");
    } else {
      dobIso = String(fechaRaw).trim();
    }

    registros.push({
      id: "sheets-" + i,
      firstName: String(nombre).trim(),
      lastName: String(apellido).trim(),
      dob: dobIso
    });
  }

  return ContentService.createTextOutput(JSON.stringify({ status: "ok", records: registros }))
    .setMimeType(ContentService.MimeType.JSON);
}

// 3. ENVÍA ALERTA DIARIA AUTOMÁTICA POR CORREO (Configurar Activador a las 8:00 AM)
function revisarCumpleanosYEnviarAlerta() {
  const hoja = SpreadsheetApp.getActiveSpreadsheet().getActiveSheet();
  const datos = hoja.getDataRange().getValues();
  const hoy = new Date();
  const mesHoy = hoy.getMonth() + 1;
  const diaHoy = hoy.getDate();

  let cumpleaneros = [];

  for (let i = 1; i &lt; datos.length; i++) {
    const [nombre, apellido, fechaNac] = datos[i];
    if (!nombre || !fechaNac) continue;
    const f = new Date(fechaNac);
    if ((f.getMonth() + 1) === mesHoy &amp;&amp; f.getDate() === diaHoy) {
      const edad = hoy.getFullYear() - f.getFullYear();
      cumpleaneros.push(`• ${nombre} ${apellido} (cumple ${edad} años)`);
    }
  }

  if (cumpleaneros.length &gt; 0) {
    MailApp.sendEmail({
      to: CORREOS_ALERTA,
      subject: `🎂 Alerta cumpleIGHO: ¡Hoy hay ${cumpleaneros.length} cumpleaños!`,
      body: `¡Hola!\n\nHoy están de cumpleaños en cumpleIGHO:\n\n${cumpleaneros.join("\n")}\n\n— Recordatorio automático de cumpleIGHO`
    });
  }
}</pre>
