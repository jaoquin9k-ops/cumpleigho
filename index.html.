        function saveAdminEmail() {
            const input = document.getElementById('admin-email-input');
            const rawEmails = input.value.trim();
            if (!rawEmails) {
                showToast('Ingresa al menos un correo electrónico válido.', 'error');
                input.focus();
                return;
            }

            const emailList = rawEmails.split(',').map(e => e.trim()).filter(Boolean);
            const allValid = emailList.every(e => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(e));

            if (!allValid) {
                showToast('Verifica que todos los correos separados por coma tengan un formato válido.', 'error');
                input.focus();
                return;
            }

            adminEmail = emailList.join(', ');
            input.value = adminEmail;
            localStorage.setItem(STORAGE_KEY_ADMIN_EMAIL, adminEmail);
            showToast(`Correo(s) de alerta guardados: ${adminEmail}`, 'success');
            checkBirthdayAlerts();
