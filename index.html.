        async function testSheetsConnection() {
            const inputUrl = document.getElementById('sheets-webhook-input').value.trim();
            const targetUrl = inputUrl || sheetsWebhookUrl;

            if (!targetUrl || !targetUrl.startsWith('https://script.google.com/')) {
                showToast('Ingresa primero una URL válida de Google Apps Script.', 'error');
                return;
            }

            showToast('Probando conexión con Google Sheets...', 'info');
            try {
                const response = await fetch(targetUrl, { method: 'GET' });
                const data = await response.json();
                if (data && data.status === 'ok') {
                    showToast(`¡Conexión exitosa! Se encontraron ${data.records?.length || 0} registros en Sheets.`, 'success');
                } else {
                    showToast('Respuesta inesperada del script. Revisa que esté implementado como Aplicación Web.', 'error');
                }
            } catch (err) {
                showToast('No se pudo conectar. Verifica los permisos de "Cualquier usuario" en Apps Script.', 'error');
            }
        }

        async function sendPersonToGoogleSheets(person) {
            if (!sheetsWebhookUrl) return false;
            try {
                await fetch(sheetsWebhookUrl, {
                    method: 'POST',
                    mode: 'no-cors',
                    headers: {
                        'Content-Type': 'text/plain;charset=utf-8'
                    },
                    body: JSON.stringify({
                        firstName: person.firstName,
                        lastName: person.lastName,
                        dob: person.dob
                    })
                });
                return true;
            } catch (err) {
                console.error('Error al enviar a Google Sheets:', err);
                return false;
            }
        }

        async function syncFromGoogleSheets(showFeedback = false) {
            if (!sheetsWebhookUrl) {
                if (showFeedback) {
                    showToast('Configura primero la URL de Google Sheets.', 'error');
                }
                return;
            }

            try {
                const response = await fetch(sheetsWebhookUrl, { method: 'GET' });
                const data = await response.json();

                if (data && data.status === 'ok' && Array.isArray(data.records)) {
                    let addedCount = 0;

                    data.records.forEach(remote => {
                        if (!remote.firstName || !remote.lastName || !remote.dob) return;
                        const normalizedDob = normalizeIsoDate(remote.dob);
                        if (!normalizedDob) return;

                        const exists = peopleList.some(local =>
                            local.firstName.trim().toLowerCase() === remote.firstName.trim().toLowerCase() &&
                            local.lastName.trim().toLowerCase() === remote.lastName.trim().toLowerCase() &&
                            local.dob === normalizedDob
                        );

                        if (!exists) {
                            peopleList.push({
                                id: remote.id || ('sheets-' + Date.now() + '-' + Math.random().toString(36).slice(2, 6)),
                                firstName: remote.firstName.trim(),
                                lastName: remote.lastName.trim(),
                                dob: normalizedDob
                            });
                            addedCount++;
                        }
                    });

                    if (addedCount > 0) {
                        savePeople();
                        renderAll();
                    }

                    if (showFeedback) {
                        showToast(
                            addedCount > 0
                                ? `Sincronizado: ${addedCount} nuevo(s) cumpleaños importado(s) desde Sheets.`
                                : 'Calendario al día con Google Sheets.',
                            'success'
                        );
                    }
                }
            } catch (err) {
                if (showFeedback) {
                    showToast('Error al sincronizar con Google Sheets. Revisa la URL.', 'error');
                }
            }
        }

        function normalizeIsoDate(raw) {
            const str = String(raw).trim();
            if (/^\d{4}-\d{2}-\d{2}$/.test(str)) return str;
            const parsed = new Date(str);
            if (!isNaN(parsed.getTime())) {
                return formatDateToISO(parsed);
            }
            return null;
        }

        // --- ENTRADA DUAL DE FECHA (TECLADO + CALENDARIO DESPLEGABLE) ---
        function setupDateInputs() {
            const textInput = document.getElementById('dob-text');
            const pickerInput = document.getElementById('dob-picker');
            if (!textInput || !pickerInput) return;

            const maxIso = formatDateToISO(REAL_TODAY);
            pickerInput.max = maxIso;

            textInput.addEventListener('input', (e) => {
                let digits = e.target.value.replace(/\D/g, '').slice(0, 8);
                let formatted = '';
                if (digits.length > 0) formatted += digits.substring(0, 2);
                if (digits.length >= 3) formatted += '/' + digits.substring(2, 4);
                if (digits.length >= 5) formatted += '/' + digits.substring(4, 8);
                e.target.value = formatted;

                if (digits.length === 8) {
                    const parsed = parseSpanishDate(formatted);
                    if (parsed) {
                        pickerInput.value = formatDateToISO(parsed);
                        hideDobError();
                        showDobPreview(parsed);
                    } else {
                        showDobError('La fecha ingresada no es válida o es futura.');
                    }
                } else {
                    hideDobPreview();
                }
            });

            pickerInput.addEventListener('change', (e) => {
                const isoVal = e.target.value;
                if (!isoVal) return;
                const [year, month, day] = isoVal.split('-').map(Number);
                const dateObj = new Date(year, month - 1, day);
                if (dateObj > REAL_TODAY) {
                    showDobError('La fecha de nacimiento no puede ser futura.');
                    return;
                }
                textInput.value = `${String(day).padStart(2, '0')}/${String(month).padStart(2, '0')}/${year}`;
                hideDobError();
                showDobPreview(dateObj);
            });
        }

        function parseSpanishDate(str) {
            const match = /^(\d{2})\/(\d{2})\/(\d{4})$/.exec(str);
            if (!match) return null;
            const day = parseInt(match[1], 10);
            const month = parseInt(match[2], 10);
            const year = parseInt(match[3], 10);

            if (year < 1900 || month < 1 || month > 12 || day < 1 || day > 31) return null;
            const date = new Date(year, month - 1, day);
            if (
                date.getFullYear() !== year ||
                date.getMonth() !== month - 1 ||
                date.getDate() !== day
            ) {
                return null;
            }
            if (date > REAL_TODAY) return null;
            return date;
        }

        function showDobError(msg) {
            const errEl = document.getElementById('dob-error');
            errEl.textContent = msg;
            errEl.classList.remove('hidden');
            hideDobPreview();
        }

        function hideDobError() {
            document.getElementById('dob-error').classList.add('hidden');
        }

        function showDobPreview(dateObj) {
            const pill = document.getElementById('dob-preview-pill');
            const text = document.getElementById('dob-preview-text');
            const age = calculateAgeOnDate(dateObj, REAL_TODAY);
            text.textContent = `${dateObj.getDate()} de ${MONTHS_ES[dateObj.getMonth()]} de ${dateObj.getFullYear()} • Edad actual: ${age.years} años`;
            pill.classList.remove('hidden');
            pill.classList.add('flex');
        }

        function hideDobPreview() {
            const pill = document.getElementById('dob-preview-pill');
            pill.classList.add('hidden');
            pill.classList.remove('flex');
        }

        // --- ENVÍO DEL FORMULARIO ---
        function setupFormSubmission() {
            const form = document.getElementById('birthday-form');
            form.addEventListener('submit', async (e) => {
                e.preventDefault();
                const firstName = document.getElementById('firstName').value.trim();
                const lastName = document.getElementById('lastName').value.trim();
                const textDate = document.getElementById('dob-text').value.trim();

                if (!firstName || !lastName) {
                    showToast('Por favor completa el nombre y el apellido.', 'error');
                    return;
                }

                const parsedDate = parseSpanishDate(textDate);
                if (!parsedDate) {
                    showDobError('Ingresa una fecha válida en formato DD/MM/AAAA o usa el calendario.');
                    document.getElementById('dob-text').focus();
                    return;
                }

                const isoDob = formatDateToISO(parsedDate);
                const newPerson = {
                    id: 'person-' + Date.now(),
                    firstName,
                    lastName,
                    dob: isoDob
                };

                // 1. Guardar inmediatamente en localStorage como respaldo
                peopleList.push(newPerson);
                savePeople();

                // 2. Si hay URL de Google Sheets configurada, enviar en vivo
                let sentToCloud = false;
                if (sheetsWebhookUrl) {
                    sentToCloud = await sendPersonToGoogleSheets(newPerson);
                }

                form.reset();
                hideDobPreview();
                hideDobError();

                currentCalendarMonth = parsedDate.getMonth();
                currentCalendarYear = REAL_TODAY.getFullYear();

                if (sentToCloud) {
                    showToast(`¡${firstName} ${lastName} guardado y enviado a Google Sheets!`, 'success');
                } else {
                    showToast(`¡Cumpleaños de ${firstName} ${lastName} registrado!`, 'success');
                }

                switchView('calendar');
            });
        }

