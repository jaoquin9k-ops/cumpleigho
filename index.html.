        function loadInitialData() {
            const savedPeople = localStorage.getItem(STORAGE_KEY_PEOPLE);
            const savedEmail = localStorage.getItem(STORAGE_KEY_ADMIN_EMAIL);
            const savedPin = localStorage.getItem(STORAGE_KEY_ADMIN_PIN);
            const savedSheetsUrl = localStorage.getItem(STORAGE_KEY_SHEETS_URL);

            if (savedPin && /^\d{4}$/.test(savedPin)) {
                adminPin = savedPin;
            } else {
                adminPin = DEFAULT_ADMIN_PIN;
                localStorage.setItem(STORAGE_KEY_ADMIN_PIN, adminPin);
            }

            if (savedSheetsUrl) {
                sheetsWebhookUrl = savedSheetsUrl;
                const urlInput = document.getElementById('sheets-webhook-input');
                if (urlInput) urlInput.value = sheetsWebhookUrl;
            }
            updateCloudStatusUI();

            if (savedPeople) {
                peopleList = JSON.parse(savedPeople);
            } else {
                const y = REAL_TODAY.getFullYear();
                const m = String(REAL_TODAY.getMonth() + 1).padStart(2, '0');
                const d = String(REAL_TODAY.getDate()).padStart(2, '0');
                peopleList = [
                    { id: 'demo-1', firstName: 'Camila', lastName: 'Mendoza', dob: `${y - 28}-${m}-${d}` },
                    { id: 'demo-2', firstName: 'Mateo', lastName: 'Villavicencio', dob: `1995-${m}-15` },
                    { id: 'demo-3', firstName: 'Sofía', lastName: 'Andrade', dob: '2001-08-22' }
                ];
                savePeople();
            }

            if (savedEmail) {
                adminEmail = savedEmail;
                const emailInput = document.getElementById('admin-email-input');
                if (emailInput) emailInput.value = adminEmail;
            }

            const simInput = document.getElementById('sim-date-input');
            if (simInput) {
                simInput.value = formatDateToISO(REAL_TODAY);
            }
        }

        function savePeople() {
            localStorage.setItem(STORAGE_KEY_PEOPLE, JSON.stringify(peopleList));
        }

        // --- NAVEGACIÓN ENTRE PESTAÑAS ---
        function switchView(viewName) {
            const views = {
                form: document.getElementById('view-form'),
                calendar: document.getElementById('view-calendar'),
                admin: document.getElementById('view-admin')
            };
            const tabs = {
                form: document.getElementById('tab-form'),
                calendar: document.getElementById('tab-calendar'),
                admin: document.getElementById('tab-admin')
            };

            const activeClasses = ['bg-white', 'text-brand-600', 'shadow-sm', 'font-semibold'];
            const inactiveClasses = ['text-slate-600', 'hover:text-slate-900', 'font-medium'];

            Object.keys(views).forEach(key => {
                if (key === viewName) {
                    views[key].classList.remove('hidden');
                    tabs[key].classList.add(...activeClasses);
                    tabs[key].classList.remove(...inactiveClasses);
                } else {
                    views[key].classList.add('hidden');
                    tabs[key].classList.remove(...activeClasses);
                    tabs[key].classList.add(...inactiveClasses);
                }
            });

            if (viewName === 'calendar') {
                renderAll();
                if (sheetsWebhookUrl) {
                    syncFromGoogleSheets(false);
                }
            } else if (viewName === 'admin') {
                renderAdminSecurityState();
            }

            if (window.lucide) {
                lucide.createIcons();
            }
        }

        // --- BLOQUEO CON PIN DEL PANEL DE ADMINISTRADOR ---
        function renderAdminSecurityState() {
            const lockScreen = document.getElementById('admin-lock-screen');
            const unlockedContent = document.getElementById('admin-unlocked-content');
            const tabLockIcon = document.getElementById('admin-tab-lock-icon');

            if (isAdminUnlocked) {
                lockScreen.classList.add('hidden');
                unlockedContent.classList.remove('hidden');
                if (tabLockIcon) {
                    tabLockIcon.setAttribute('data-lucide', 'unlock');
                    tabLockIcon.classList.remove('text-slate-400');
                    tabLockIcon.classList.add('text-emerald-600');
                }
                checkBirthdayAlerts();
            } else {
                lockScreen.classList.remove('hidden');
                unlockedContent.classList.add('hidden');
                if (tabLockIcon) {
                    tabLockIcon.setAttribute('data-lucide', 'lock');
                    tabLockIcon.classList.remove('text-emerald-600');
                    tabLockIcon.classList.add('text-slate-400');
                }
                const pinInput = document.getElementById('admin-pin-input');
                if (pinInput) {
                    pinInput.value = '';
                    setTimeout(() => pinInput.focus(), 50);
                }
            }
            if (window.lucide) {
                lucide.createIcons();
            }
        }

        function handlePinUnlock(event) {
            event.preventDefault();
            const pinInput = document.getElementById('admin-pin-input');
            const errorEl = document.getElementById('admin-pin-error');
            const enteredPin = pinInput.value.trim();

            if (enteredPin === adminPin) {
                isAdminUnlocked = true;
                errorEl.classList.add('hidden');
                pinInput.value = '';
                renderAdminSecurityState();
                showToast('Panel de administrador desbloqueado.', 'success');
            } else {
                errorEl.classList.remove('hidden');
                pinInput.value = '';
                pinInput.focus();
                showToast('PIN incorrecto. Verifica los 4 dígitos.', 'error');
            }
        }

        function lockAdminPanel() {
            isAdminUnlocked = false;
            renderAdminSecurityState();
            showToast('Panel de administrador bloqueado.', 'info');
        }

        function handleChangePin(event) {
            event.preventDefault();
            const newPin = document.getElementById('new-pin-input').value.trim();
            const confirmPin = document.getElementById('confirm-pin-input').value.trim();

            if (!/^\d{4}$/.test(newPin)) {
                showToast('El nuevo PIN debe tener exactamente 4 dígitos numéricos.', 'error');
                return;
            }
            if (newPin !== confirmPin) {
                showToast('Los PIN ingresados no coinciden.', 'error');
                return;
