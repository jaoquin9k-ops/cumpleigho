<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>cumpleIGHO — Gestor de Cumpleaños y Calendario</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            50: '#f5f3ff',
                            100: '#ede9fe',
                            200: '#ddd6fe',
                            300: '#c4b5fd',
                            400: '#a78bfa',
                            500: '#8b5cf6',
                            600: '#7c3aed',
                            700: '#6d28d9',
                            800: '#5b21b6',
                            900: '#4c1d95',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: transparent;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 9999px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(6px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .animate-fade-in {
            animation: fadeIn 0.25s ease-out forwards;
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col selection:bg-brand-200 selection:text-brand-900">

    <!-- =====================================================================
         BARRA DE NAVEGACIÓN SUPERIOR
    ====================================================================== -->
    <header class="sticky top-0 z-30 bg-white/85 backdrop-blur-md border-b border-slate-200/80">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-2">
            <!-- Logo / Marca -->
            <div class="flex items-center gap-2.5 shrink-0">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-brand-600 to-purple-500 text-white flex items-center justify-center shadow-md shadow-brand-500/20">
                    <i data-lucide="cake" class="w-5 h-5"></i>
                </div>
                <div>
                    <span class="font-bold text-lg tracking-tight text-slate-900">cumple<span class="text-brand-600">IGHO</span></span>
                    <p class="text-[11px] text-slate-500 hidden sm:block leading-none mt-0.5">Registro y Alertas de Cumpleaños</p>
                </div>
            </div>

            <!-- Pestañas de Navegación (3 vistas: Registro, Calendario, Administrador) -->
            <nav class="flex items-center bg-slate-100 p-1 rounded-xl border border-slate-200/70">
                <button type="button" id="tab-form" onclick="switchView('form')"
                    class="flex items-center gap-1.5 px-3 sm:px-4 py-2 rounded-lg text-xs sm:text-sm font-semibold transition-all bg-white text-brand-600 shadow-sm cursor-pointer">
                    <i data-lucide="user-plus" class="w-4 h-4"></i>
                    <span class="hidden sm:inline">Ingresar Cumpleaños</span>
                    <span class="sm:hidden">Registrar</span>
                </button>
                <button type="button" id="tab-calendar" onclick="switchView('calendar')"
                    class="flex items-center gap-1.5 px-3 sm:px-4 py-2 rounded-lg text-xs sm:text-sm font-medium text-slate-600 hover:text-slate-900 transition-all cursor-pointer">
                    <i data-lucide="calendar-days" class="w-4 h-4"></i>
                    <span>Calendario</span>
                    <span id="nav-badge" class="ml-0.5 px-1.5 py-0.2 text-[11px] font-bold rounded-full bg-brand-100 text-brand-700">0</span>
                </button>
                <button type="button" id="tab-admin" onclick="switchView('admin')"
                    class="flex items-center gap-1.5 px-3 sm:px-4 py-2 rounded-lg text-xs sm:text-sm font-medium text-slate-600 hover:text-slate-900 transition-all cursor-pointer">
                    <i id="admin-tab-lock-icon" data-lucide="lock" class="w-4 h-4 text-slate-400"></i>
                    <span class="hidden sm:inline">Administrador</span>
                    <span class="sm:hidden">Admin</span>
                </button>
            </nav>

            <!-- Estado de sincronización en nube -->
            <div class="hidden md:flex items-center gap-2 text-xs font-medium px-3 py-1.5 rounded-full bg-slate-100 text-slate-600 border border-slate-200">
                <span id="cloud-status-dot" class="w-2 h-2 rounded-full bg-slate-400"></span>
                <span id="cloud-status-text">Modo Local</span>
            </div>
        </div>
    </header>

    <!-- =====================================================================
         CONTENEDOR PRINCIPAL
    ====================================================================== -->
    <main class="flex-1 max-w-6xl w-full mx-auto px-4 sm:px-6 py-6 sm:py-10">

        <!-- =====================================================================
             VISTA 1: FORMULARIO DE INGRESO DE CUMPLEAÑOS
        ====================================================================== -->
        <section id="view-form" class="max-w-xl mx-auto animate-fade-in">
            <div class="text-center mb-8">
                <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-brand-50 text-brand-700 text-xs font-semibold border border-brand-200/60 mb-3">
                    <i data-lucide="sparkles" class="w-3.5 h-3.5"></i> Nuevo Registro
                </div>
                <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">Registra un Cumpleaños</h1>
                <p class="text-slate-500 text-sm sm:text-base mt-2">
                    Completa los datos para añadir la fecha al calendario general de <strong>cumpleIGHO</strong>.
                </p>
            </div>

            <!-- Tarjeta del Formulario -->
            <div class="bg-white rounded-3xl shadow-xl shadow-slate-200/60 border border-slate-200/80 p-6 sm:p-8">
                <form id="birthday-form" class="space-y-5" novalidate>
                    <!-- Fila Nombre y Apellido -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <!-- Casilla 1: Nombre -->
                        <div class="space-y-1.5">
                            <label for="firstName" class="block text-sm font-semibold text-slate-700">
                                Nombre <span class="text-rose-500">*</span>
                            </label>
                            <div class="relative">
                                <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                                    <i data-lucide="user" class="w-4 h-4"></i>
                                </div>
                                <input type="text" id="firstName" required placeholder="Ej. Valentina"
                                    class="w-full pl-10 pr-4 py-3 rounded-xl border border-slate-300 bg-slate-50/50 text-slate-900 placeholder-slate-400 text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-all">
                            </div>
                        </div>

                        <!-- Casilla 2: Apellido -->
                        <div class="space-y-1.5">
                            <label for="lastName" class="block text-sm font-semibold text-slate-700">
                                Apellido <span class="text-rose-500">*</span>
                            </label>
                            <div class="relative">
                                <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                                    <i data-lucide="badge-check" class="w-4 h-4"></i>
                                </div>
                                <input type="text" id="lastName" required placeholder="Ej. Rojas"
                                    class="w-full pl-10 pr-4 py-3 rounded-xl border border-slate-300 bg-slate-50/50 text-slate-900 placeholder-slate-400 text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-all">
                            </div>
                        </div>
                    </div>

                    <!-- Casilla 3: Fecha de Nacimiento (Teclado + Calendario desplegable) -->
                    <div class="space-y-2">
                        <label for="dob-text" class="block text-sm font-semibold text-slate-700">
                            Fecha de nacimiento <span class="text-rose-500">*</span>
                        </label>
                        <div class="relative flex items-center">
                            <div class="relative flex-1">
                                <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                                    <i data-lucide="calendar-days" class="w-4 h-4"></i>
                                </div>
                                <input type="text" id="dob-text" inputmode="numeric" maxlength="10"
                                    placeholder="DD/MM/AAAA (ej. 15/08/1996)"
                                    class="w-full pl-10 pr-28 py-3 rounded-xl border border-slate-300 bg-slate-50/50 text-slate-900 placeholder-slate-400 text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-all">
                            </div>
                            <label for="dob-picker" title="Abrir calendario desplegable"
                                class="absolute right-1.5 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-brand-50 hover:bg-brand-100 text-brand-700 text-xs font-semibold border border-brand-200 transition-colors cursor-pointer">
                                <i data-lucide="calendar" class="w-3.5 h-3.5"></i>
                                <span>Calendario</span>
                                <input type="date" id="dob-picker" class="sr-only">
                            </label>
                        </div>
                        <p id="dob-error" class="hidden text-xs font-medium text-rose-600 mt-1"></p>
                        <div id="dob-preview-pill" class="hidden items-center gap-2 text-xs text-brand-700 bg-brand-50/80 border border-brand-200/70 px-3 py-2 rounded-xl mt-2">
                            <i data-lucide="sparkles" class="w-3.5 h-3.5 shrink-0"></i>
                            <span id="dob-preview-text" class="font-medium"></span>
                        </div>
                    </div>

                    <!-- Botones de Acción -->
                    <div class="pt-2 flex flex-col sm:flex-row items-center gap-3">
                        <button type="submit" id="submit-btn"
                            class="w-full sm:flex-1 inline-flex items-center justify-center gap-2 bg-gradient-to-r from-brand-600 to-purple-600 hover:from-brand-700 hover:to-purple-700 text-white font-semibold py-3.5 px-6 rounded-xl shadow-md shadow-brand-500/25 transition-all cursor-pointer">
                            <i data-lucide="check-circle-2" class="w-4 h-4"></i>
                            <span>Guardar y Ver en Calendario</span>
                        </button>
                        <button type="button" onclick="switchView('calendar')"
                            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-white hover:bg-slate-50 text-slate-700 font-medium py-3.5 px-5 rounded-xl border border-slate-200 transition-all cursor-pointer">
                            <i data-lucide="calendar" class="w-4 h-4 text-slate-500"></i>
                            <span>Ir al Calendario</span>
                        </button>
                    </div>
                </form>
            </div>
        </section>

        <!-- =====================================================================
             VISTA 2: CALENDARIO INTERACTIVO
        ====================================================================== -->
        <section id="view-calendar" class="hidden space-y-6 animate-fade-in">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
                <!-- Columna Principal: Calendario Mensual (8 columnas) -->
                <div class="lg:col-span-8 bg-white rounded-3xl shadow-xl shadow-slate-200/60 border border-slate-200/80 overflow-hidden">
                    <!-- Cabecera del Calendario -->
                    <div class="p-4 sm:p-6 border-b border-slate-100 flex flex-wrap items-center justify-between gap-4">
                        <div class="flex items-center gap-3">
                            <button type="button" onclick="changeMonth(-1)" title="Mes anterior"
                                class="p-2.5 rounded-xl border border-slate-200 hover:bg-slate-50 text-slate-600 transition-colors cursor-pointer">
                                <i data-lucide="chevron-left" class="w-5 h-5"></i>
                            </button>
                            <h2 id="calendar-month-label" class="text-lg sm:text-xl font-bold text-slate-900 min-w-[170px] text-center capitalize">
                                Noviembre 2026
                            </h2>
                            <button type="button" onclick="changeMonth(1)" title="Mes siguiente"
                                class="p-2.5 rounded-xl border border-slate-200 hover:bg-slate-50 text-slate-600 transition-colors cursor-pointer">
                                <i data-lucide="chevron-right" class="w-5 h-5"></i>
                            </button>
                        </div>

                        <div class="flex items-center gap-2">
                            <button type="button" onclick="goToToday()"
                                class="px-3.5 py-2 rounded-xl text-xs font-semibold bg-slate-100 hover:bg-slate-200/80 text-slate-700 transition-colors cursor-pointer">
                                Hoy
                            </button>
                            <button type="button" onclick="syncFromGoogleSheets(true)" id="calendar-sync-btn"
                                class="hidden items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-semibold bg-emerald-50 hover:bg-emerald-100 text-emerald-700 border border-emerald-200 transition-colors cursor-pointer">
                                <i data-lucide="refresh-cw" class="w-3.5 h-3.5"></i>
                                <span>Actualizar</span>
                            </button>
                            <button type="button" onclick="switchView('form')"
                                class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-semibold bg-brand-600 hover:bg-brand-700 text-white shadow-sm transition-colors cursor-pointer">
                                <i data-lucide="plus" class="w-3.5 h-3.5"></i>
                                <span>Nuevo</span>
                            </button>
                        </div>
                    </div>

                    <!-- Días de la semana -->
                    <div class="grid grid-cols-7 bg-slate-50 border-b border-slate-200/70 text-center py-2.5 text-[11px] sm:text-xs font-bold uppercase tracking-wider text-slate-500">
                        <div>Dom</div>
                        <div>Lun</div>
                        <div>Mar</div>
                        <div>Mié</div>
                        <div>Jue</div>
                        <div>Vie</div>
                        <div>Sáb</div>
                    </div>

                    <!-- Cuadrícula de días -->
                    <div id="calendar-grid" class="grid grid-cols-7 bg-slate-100/50"></div>
                </div>

                <!-- Columna Lateral: Próximos Cumpleaños (4 columnas) -->
                <div class="lg:col-span-4 space-y-6">
                    <div class="bg-white rounded-3xl shadow-xl shadow-slate-200/60 border border-slate-200/80 p-5 sm:p-6">
                        <div class="flex items-center justify-between mb-4">
                            <div class="flex items-center gap-2">
                                <div class="w-8 h-8 rounded-xl bg-brand-100 text-brand-600 flex items-center justify-center">
                                    <i data-lucide="gift" class="w-4 h-4"></i>
                                </div>
                                <h3 class="font-bold text-slate-900">Próximos Cumpleaños</h3>
                            </div>
                            <span id="total-people-pill" class="text-xs font-semibold px-2.5 py-1 rounded-full bg-slate-100 text-slate-600">0 total</span>
                        </div>

                        <p class="text-xs text-slate-500 mb-3">
                            Haz clic en cualquier persona en el calendario o en esta lista para ver el cálculo de edad.
                        </p>

                        <div id="upcoming-list" class="space-y-2 max-h-[420px] overflow-y-auto pr-1"></div>
                    </div>
                </div>
            </div>
        </section>

        <!-- =====================================================================
             VISTA 3: PANEL DE ADMINISTRADOR (PROTEGIDO POR PIN)
        ====================================================================== -->
        <section id="view-admin" class="hidden animate-fade-in">
            <!-- PANTALLA DE BLOQUEO CON PIN -->
            <div id="admin-lock-screen" class="max-w-md mx-auto py-6">
                <div class="bg-white rounded-3xl shadow-xl shadow-slate-200/70 border border-slate-200/80 p-7 sm:p-8 text-center">
                    <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-slate-800 to-slate-950 text-white flex items-center justify-center mx-auto mb-5 shadow-lg">
                        <i data-lucide="shield-lock" class="w-8 h-8 text-brand-400"></i>
                    </div>
                    <span class="inline-block px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-[11px] font-bold uppercase tracking-wider mb-2">
                        Acceso Restringido
                    </span>
                    <h2 class="text-2xl font-extrabold text-slate-900">Panel de Administrador</h2>
                    <p class="text-xs sm:text-sm text-slate-500 mt-1.5 mb-6">
                        Ingresa el PIN numérico de 4 dígitos para configurar alertas por correo y la conexión con Google Sheets.
                    </p>

                    <form id="admin-pin-form" class="space-y-4" onsubmit="handlePinUnlock(event)">
                        <div>
                            <label for="admin-pin-input" class="sr-only">PIN de 4 dígitos</label>
                            <input type="password" id="admin-pin-input" inputmode="numeric" pattern="[0-9]*" maxlength="4"
                                placeholder="••••" autocomplete="off"
                                class="w-44 mx-auto block text-center text-2xl font-extrabold tracking-[0.5em] py-3 px-4 rounded-2xl border-2 border-slate-300 bg-slate-50 text-slate-900 focus:bg-white focus:outline-none focus:border-brand-600 focus:ring-4 focus:ring-brand-500/15 transition-all">
                            <p id="admin-pin-error" class="hidden text-xs font-semibold text-rose-600 mt-2">
                                PIN incorrecto. Inténtalo nuevamente.
                            </p>
                        </div>

                        <button type="submit"
                            class="w-full inline-flex items-center justify-center gap-2 bg-slate-900 hover:bg-slate-800 text-white font-semibold py-3.5 px-6 rounded-xl shadow-md transition-all cursor-pointer">
                            <i data-lucide="unlock" class="w-4 h-4"></i>
                            <span>Desbloquear Panel</span>
                        </button>
                    </form>

                    <p class="text-[11px] text-slate-400 mt-5">
                        PIN inicial por defecto: <span class="font-mono font-semibold text-slate-500">1234</span> (puedes cambiarlo al entrar).
                    </p>
                </div>
            </div>

            <!-- CONTENIDO DEL PANEL DE ADMINISTRADOR DESBLOQUEADO -->
            <div id="admin-unlocked-content" class="hidden space-y-6">
                <!-- Barra Superior del Panel Admin -->
                <div class="bg-slate-900 text-white rounded-3xl p-5 sm:p-6 flex flex-wrap items-center justify-between gap-4 shadow-lg">
                    <div class="flex items-center gap-3">
                        <div class="w-11 h-11 rounded-2xl bg-brand-600/30 border border-brand-400/30 text-brand-300 flex items-center justify-center">
                            <i data-lucide="shield-check" class="w-6 h-6"></i>
                        </div>
                        <div>
                            <h2 class="text-lg sm:text-xl font-bold">Administración de cumpleIGHO</h2>
                            <p class="text-xs text-slate-400">Gestión de alertas por correo, nube Google Sheets y seguridad</p>
                        </div>
                    </div>

                    <button type="button" onclick="lockAdminPanel()"
                        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-white/10 hover:bg-white/20 text-white text-xs font-semibold border border-white/15 transition-colors cursor-pointer">
                        <i data-lucide="lock" class="w-4 h-4 text-amber-300"></i>
                        <span>Bloquear panel</span>
                    </button>
                </div>

                <!-- Banner de Alerta Activa si hoy hay cumpleaños -->
                <div id="admin-alert-banner" class="hidden bg-gradient-to-r from-amber-50 to-orange-50 border border-amber-300/80 rounded-3xl p-5 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 shadow-sm">
                    <div class="flex items-start gap-3.5">
                        <div class="w-10 h-10 rounded-2xl bg-amber-500 text-white flex items-center justify-center shrink-0 mt-0.5">
                            <i data-lucide="bell-ring" class="w-5 h-5"></i>
                        </div>
                        <div>
                            <h3 id="alert-banner-title" class="font-bold text-amber-950 text-sm sm:text-base">¡Hoy hay cumpleaños!</h3>
                            <p id="alert-banner-desc" class="text-xs sm:text-sm text-amber-800 mt-0.5"></p>
                        </div>
                    </div>
                    <button type="button" onclick="triggerEmailAlert(false)"
                        class="w-full sm:w-auto shrink-0 inline-flex items-center justify-center gap-2 bg-amber-600 hover:bg-amber-700 text-white text-xs sm:text-sm font-semibold px-4 py-2.5 rounded-xl shadow-sm transition-colors cursor-pointer">
                        <i data-lucide="send" class="w-4 h-4"></i>
                        <span>Enviar Alerta Ahora</span>
                    </button>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                    <!-- TARJETA 1: CONEXIÓN EN VIVO CON GOOGLE SHEETS -->
                    <div class="bg-white rounded-3xl shadow-xl shadow-slate-200/60 border border-slate-200/80 p-6 space-y-5">
                        <div class="flex items-start justify-between gap-2">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0">
                                    <i data-lucide="sheet" class="w-5 h-5"></i>
                                </div>
                                <div>
                                    <h3 class="font-bold text-slate-900 text-base">Conexión en Vivo con Google Sheets</h3>
                                    <p class="text-xs text-slate-500">Recibe registros de otros usuarios y sincroniza el calendario</p>
                                </div>
                            </div>
                            <span id="sheets-badge-status" class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-slate-100 text-slate-500">
                                Sin conectar
                            </span>
                        </div>

                        <div class="space-y-2">
                            <label for="sheets-webhook-input" class="block text-xs font-semibold text-slate-700">
                                URL de Aplicación Web de Google Apps Script
                            </label>
                            <input type="url" id="sheets-webhook-input"
                                placeholder="https://script.google.com/macros/s/AKfycb.../exec"
                                class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 bg-slate-50 text-slate-900 text-xs sm:text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500">
                            <p class="text-[11px] text-slate-500">
                                Cuando alguien llene el formulario, los datos viajarán automáticamente a tu hoja de Google Sheets.
                            </p>
                        </div>

                        <div class="flex flex-wrap gap-2">
                            <button type="button" onclick="saveSheetsUrl()"
                                class="flex-1 inline-flex items-center justify-center gap-1.5 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold px-4 py-2.5 rounded-xl transition-colors cursor-pointer">
                                <i data-lucide="save" class="w-3.5 h-3.5"></i>
                                <span>Guardar URL</span>
                            </button>
                            <button type="button" onclick="testSheetsConnection()"
                                class="inline-flex items-center justify-center gap-1.5 bg-slate-100 hover:bg-slate-200 text-slate-800 text-xs font-semibold px-3.5 py-2.5 rounded-xl transition-colors cursor-pointer">
                                <i data-lucide="plug-zap" class="w-3.5 h-3.5 text-emerald-600"></i>
                                <span>Probar conexión</span>
                            </button>
                            <button type="button" onclick="syncFromGoogleSheets(true)"
                                class="inline-flex items-center justify-center gap-1.5 bg-brand-50 hover:bg-brand-100 text-brand-700 border border-brand-200 text-xs font-semibold px-3.5 py-2.5 rounded-xl transition-colors cursor-pointer">
                                <i data-lucide="refresh-cw" class="w-3.5 h-3.5"></i>
                                <span>Sincronizar registros desde Sheets</span>
                            </button>
                        </div>

                        <div class="pt-2 border-t border-slate-100">
