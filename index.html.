        // --- CALENDARIO MENSUAL ---
        function changeMonth(delta) {
            currentCalendarMonth += delta;
            if (currentCalendarMonth > 11) {
                currentCalendarMonth = 0;
                currentCalendarYear++;
            } else if (currentCalendarMonth < 0) {
                currentCalendarMonth = 11;
                currentCalendarYear--;
            }
            renderCalendar();
        }

        function goToToday() {
            currentCalendarYear = REAL_TODAY.getFullYear();
            currentCalendarMonth = REAL_TODAY.getMonth();
            renderCalendar();
        }

        function renderCalendar() {
            const label = document.getElementById('calendar-month-label');
            const grid = document.getElementById('calendar-grid');
            label.textContent = `${MONTHS_ES[currentCalendarMonth]} ${currentCalendarYear}`;
            grid.innerHTML = '';

            const firstDayOfMonth = new Date(currentCalendarYear, currentCalendarMonth, 1).getDay();
            const daysInMonth = new Date(currentCalendarYear, currentCalendarMonth + 1, 0).getDate();

            const monthBirthdays = {};
            peopleList.forEach(person => {
                const [, m, d] = person.dob.split('-').map(Number);
                if (m - 1 === currentCalendarMonth) {
                    if (!monthBirthdays[d]) monthBirthdays[d] = [];
                    monthBirthdays[d].push(person);
                }
            });

            for (let i = 0; i < firstDayOfMonth; i++) {
                const emptyCell = document.createElement('div');
                emptyCell.className = 'min-h-[88px] sm:min-h-[108px] bg-slate-50/60 border-b border-r border-slate-100';
                grid.appendChild(emptyCell);
            }

            for (let day = 1; day <= daysInMonth; day++) {
                const isToday =
                    day === REAL_TODAY.getDate() &&
                    currentCalendarMonth === REAL_TODAY.getMonth() &&
                    currentCalendarYear === REAL_TODAY.getFullYear();

                const bdays = monthBirthdays[day] || [];
                const cell = document.createElement('div');
                cell.className = `min-h-[88px] sm:min-h-[108px] p-1.5 sm:p-2 border-b border-r border-slate-100 transition-colors flex flex-col justify-between ${
                    bdays.length > 0 ? 'bg-brand-50/30 hover:bg-brand-50/70' : 'bg-white hover:bg-slate-50/70'
                }`;

                const topRow = document.createElement('div');
                topRow.className = 'flex items-center justify-between';

                const dayNum = document.createElement('span');
                dayNum.textContent = day;
                dayNum.className = isToday
                    ? 'w-7 h-7 rounded-full bg-brand-600 text-white text-xs font-bold flex items-center justify-center shadow-sm'
                    : 'text-xs sm:text-sm font-semibold text-slate-700 px-1';
                topRow.appendChild(dayNum);

                if (bdays.length > 0) {
                    const cakeIcon = document.createElement('span');
                    cakeIcon.className = 'text-xs';
                    cakeIcon.textContent = '🎂';
                    topRow.appendChild(cakeIcon);
                }
                cell.appendChild(topRow);

                const listDiv = document.createElement('div');
                listDiv.className = 'mt-1.5 space-y-1 overflow-y-auto max-h-[70px]';

                bdays.forEach(person => {
                    const birthYear = parseInt(person.dob.split('-')[0], 10);
                    const turningAge = currentCalendarYear - birthYear;

                    const btn = document.createElement('button');
                    btn.type = 'button';
                    btn.onclick = () => openDetailModal(person.id, currentCalendarYear);
                    btn.className =
                        'w-full text-left px-2 py-1 rounded-lg bg-gradient-to-r from-brand-600 to-purple-600 hover:from-brand-700 hover:to-purple-700 text-white text-[11px] sm:text-xs font-medium shadow-sm transition-all flex items-center justify-between gap-1 cursor-pointer group';
                    btn.innerHTML = `
                        <span class="truncate font-semibold">${escapeHtml(person.firstName)} ${escapeHtml(person.lastName[0])}.</span>
                        <span class="shrink-0 bg-white/20 px-1.5 py-0.2 rounded text-[10px] font-bold">${turningAge >= 0 ? turningAge + 'a' : ''}</span>
                    `;
                    listDiv.appendChild(btn);
                });

                cell.appendChild(listDiv);
                grid.appendChild(cell);
            }

            const totalCells = firstDayOfMonth + daysInMonth;
            const remaining = (7 - (totalCells % 7)) % 7;
            for (let i = 0; i < remaining; i++) {
                const trailing = document.createElement('div');
                trailing.className = 'min-h-[88px] sm:min-h-[108px] bg-slate-50/60 border-b border-r border-slate-100';
                grid.appendChild(trailing);
            }
        }

        // --- LISTA DE PRÓXIMOS CUMPLEAÑOS ---
        function renderUpcomingList() {
            const container = document.getElementById('upcoming-list');
            if (!container) return;

            if (peopleList.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-8 text-slate-400 text-xs">
                        No hay cumpleaños registrados todavía.
                    </div>
                `;
                return;
            }

            const enriched = peopleList.map(p => {
                const daysUntil = getDaysUntilNextBirthday(p.dob, REAL_TODAY);
                const [y, m, d] = p.dob.split('-').map(Number);
                const nextYear = REAL_TODAY.getFullYear() + (daysUntil === 0 ? 0 : (new Date(REAL_TODAY.getFullYear(), m - 1, d) < new Date(REAL_TODAY.getFullYear(), REAL_TODAY.getMonth(), REAL_TODAY.getDate()) ? 1 : 0));
                return { ...p, daysUntil, nextYear, day: d, month: m };
            }).sort((a, b) => a.daysUntil - b.daysUntil);

            container.innerHTML = enriched.map(p => {
                const isToday = p.daysUntil === 0;
                const badgeText = isToday
                    ? '¡Hoy!'
                    : p.daysUntil === 1
                    ? 'Mañana'
                    : `En ${p.daysUntil} días`;
                const badgeClass = isToday
                    ? 'bg-amber-100 text-amber-800 border-amber-200 animate-pulse'
                    : 'bg-slate-100 text-slate-600 border-slate-200';

                return `
                    <button type="button" onclick="openDetailModal('${p.id}', ${p.nextYear})"
                        class="w-full flex items-center justify-between p-2.5 rounded-2xl border border-slate-100 hover:border-brand-200 hover:bg-brand-50/40 transition-all text-left cursor-pointer group">
                        <div class="flex items-center gap-3 min-w-0">
                            <div class="w-9 h-9 rounded-xl ${isToday ? 'bg-amber-500 text-white' : 'bg-brand-100 text-brand-700'} font-bold text-xs flex items-center justify-center shrink-0 uppercase">
                                ${escapeHtml(p.firstName[0])}${escapeHtml(p.lastName[0])}
                            </div>
                            <div class="truncate">
                                <p class="text-sm font-semibold text-slate-800 group-hover:text-brand-700 truncate">
                                    ${escapeHtml(p.firstName)} ${escapeHtml(p.lastName)}
                                </p>
                                <p class="text-xs text-slate-500">${p.day} de ${MONTHS_ES[p.month - 1]}</p>
                            </div>
                        </div>
                        <span class="shrink-0 text-[11px] font-bold px-2.5 py-1 rounded-full border ${badgeClass}">
                            ${badgeText}
                        </span>
                    </button>
                `;
            }).join('');
        }

        // --- MODAL DE DETALLES DEL CUMPLEAÑOS ---
        function openDetailModal(personId, selectedYear) {
            const person = peopleList.find(p => p.id === personId);
            if (!person) return;

            const [birthYear, birthMonth, birthDay] = person.dob.split('-').map(Number);
            const birthDate = new Date(birthYear, birthMonth - 1, birthDay);

            const turningAge = selectedYear - birthYear;
            const currentAge = calculateAgeOnDate(birthDate, REAL_TODAY);
            const daysLeft = getDaysUntilNextBirthday(person.dob, REAL_TODAY);
            const generation = getGeneration(birthYear);

            document.getElementById('modal-avatar').textContent = `${person.firstName[0]}${person.lastName[0]}`;
            document.getElementById('modal-full-name').textContent = `${person.firstName} ${person.lastName}`;
            document.getElementById('modal-dob-formatted').textContent =
                `Nació el ${birthDay} de ${MONTHS_ES[birthMonth - 1]} de ${birthYear}`;

            document.getElementById('modal-selected-year').textContent = selectedYear;
            document.getElementById('modal-turning-age').textContent = turningAge >= 0 ? turningAge : '—';
            document.getElementById('modal-current-age').textContent = currentAge.years;
            document.getElementById('modal-exact-months').textContent =
                `y ${currentAge.months} ${currentAge.months === 1 ? 'mes' : 'meses'}`;

            const statusBadge = document.getElementById('modal-status-badge');
            const countdownEl = document.getElementById('modal-countdown');

            if (daysLeft === 0) {
                statusBadge.textContent = '🎉 ¡Está de cumpleaños hoy!';
                statusBadge.className = 'inline-block px-2.5 py-0.5 rounded-full text-[11px] font-bold uppercase tracking-wider bg-amber-400 text-slate-900 mb-1';
                countdownEl.innerHTML = '<span class="text-amber-600">¡Es hoy! 🎂</span>';
            } else {
                statusBadge.textContent = 'Ficha de Cumpleaños';
                statusBadge.className = 'inline-block px-2.5 py-0.5 rounded-full text-[11px] font-bold uppercase tracking-wider bg-white/20 text-white mb-1';
                countdownEl.textContent = `Faltan ${daysLeft} ${daysLeft === 1 ? 'día' : 'días'}`;
            }

            document.getElementById('modal-generation').textContent = generation;

            const deleteBtn = document.getElementById('modal-delete-btn');
            deleteBtn.onclick = () => deletePerson(person.id);

            document.getElementById('detail-modal').classList.remove('hidden');
            if (window.lucide) {
                lucide.createIcons();
            }
        }

