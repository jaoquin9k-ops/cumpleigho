    <script>
        // --- CONSTANTES Y ESTADO GLOBAL ---
        const STORAGE_KEY_PEOPLE = 'cumpleigho_registros_v1';
        const STORAGE_KEY_ADMIN_EMAIL = 'cumpleigho_admin_email_v1';
        const STORAGE_KEY_ADMIN_PIN = 'cumpleigho_admin_pin_v1';
        const STORAGE_KEY_SHEETS_URL = 'cumpleigho_sheets_url_v1';
        const DEFAULT_ADMIN_PIN = '1234';

        const MONTHS_ES = [
            'Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio',
            'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'
        ];

        const REAL_TODAY = new Date();
        let currentCalendarYear = REAL_TODAY.getFullYear();
        let currentCalendarMonth = REAL_TODAY.getMonth();
        let peopleList = [];
        let adminEmail = '';
        let adminPin = DEFAULT_ADMIN_PIN;
        let sheetsWebhookUrl = '';
        let isAdminUnlocked = false;

        // --- INICIALIZACIÓN ---
        document.addEventListener('DOMContentLoaded', () => {
            try {
                loadInitialData();
                setupDateInputs();
                setupFormSubmission();
                setupAdminPanel();
                renderAll();
                if (sheetsWebhookUrl) {
                    syncFromGoogleSheets(false);
