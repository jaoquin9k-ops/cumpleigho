        function resetSimDateToToday() {
            const simInput = document.getElementById('sim-date-input');
            if (simInput) {
                simInput.value = formatDateToISO(REAL_TODAY);
                checkBirthdayAlerts();
            }
        }

        function getReferenceDate() {
            const simVal = document.getElementById('sim-date-input')?.value;
            if (simVal) {
                const [y, m, d] = simVal.split('-').map(Number);
                return new Date(y, m - 1, d);
            }
            return REAL_TODAY;
        }

        function getBirthdaysOnDate(refDate) {
            const m = refDate.getMonth() + 1;
            const d = refDate.getDate();
            return peopleList.filter(p => {
                const [, pm, pd] = p.dob.split('-').map(Number);
                return pm === m && pd === d;
            });
        }

        function checkBirthdayAlerts() {
            const refDate = getReferenceDate();
            const matches = getBirthdaysOnDate(refDate);
            const banner = document.getElementById('admin-alert-banner');
            const titleEl = document.getElementById('alert-banner-title');
            const descEl = document.getElementById('alert-banner-desc');

            if (!banner) return;

            if (matches.length > 0) {
                const names = matches.map(p => `${p.firstName} ${p.lastName}`).join(', ');
                titleEl.textContent = `🎉 ¡Alerta de Cumpleaños (${matches.length}) para el ${refDate.getDate()} de ${MONTHS_ES[refDate.getMonth()]}!`;
                descEl.textContent = adminEmail
                    ? `Hoy cumplen años: ${names}. Listo para enviar alerta a ${adminEmail}.`
                    : `Hoy cumplen años: ${names}. Configura tu correo de administrador para enviar la alerta.`;
                banner.classList.remove('hidden');
            } else {
                banner.classList.add('hidden');
            }
        }

        function triggerEmailAlert(forceTest = false) {
            const emailInput = document.getElementById('admin-email-input').value.trim();
            const targetEmails = emailInput || adminEmail;

            if (!targetEmails) {
                showToast('Primero ingresa y guarda el correo de administrador.', 'error');
                document.getElementById('admin-email-input').focus();
                return;
            }

            if (emailInput && emailInput !== adminEmail) {
                adminEmail = emailInput;
                localStorage.setItem(STORAGE_KEY_ADMIN_EMAIL, adminEmail);
            }

            const refDate = getReferenceDate();
            let matches = getBirthdaysOnDate(refDate);
            let isFallbackNext = false;

            if (matches.length === 0 && forceTest) {
                if (peopleList.length === 0) {
                    showToast('Registra al menos una persona para probar la alerta.', 'error');
                    return;
                }
                const sorted = [...peopleList].sort(
                    (a, b) => getDaysUntilNextBirthday(a.dob, refDate) - getDaysUntilNextBirthday(b.dob, refDate)
                );
                matches = [sorted[0]];
                isFallbackNext = true;
            }

            if (matches.length === 0) {
                showToast('No hay cumpleaños en la fecha seleccionada.', 'info');
                return;
            }

            const namesList = matches.map(p => `${p.firstName} ${p.lastName}`).join(', ');
            const detailsLines = matches.map(p => {
                const [by, bm, bd] = p.dob.split('-').map(Number);
                const age = refDate.getFullYear() - by;
                return `- ${p.firstName} ${p.lastName} (Fecha nac.: ${String(bd).padStart(2, '0')}/${String(bm).padStart(2, '0')}/${by} • Cumple ${age} años)`;
            }).join('\n');

            const subject = `🎂 Recordatorio de Cumpleaños (cumpleIGHO): ${namesList}`;
            const body =
`Hola Administrador,

Este es un recordatorio automático generado desde cumpleIGHO.
${isFallbackNext ? '(Nota: Prueba de alerta con el próximo cumpleaños registrado)' : `Fecha del recordatorio: ${refDate.getDate()} de ${MONTHS_ES[refDate.getMonth()]} de ${refDate.getFullYear()}`}

Personas que cumplen años:
${detailsLines}

¡No olvides enviarles tus felicitaciones!
— Sistema cumpleIGHO`;

            const mailtoUrl = `mailto:${encodeURIComponent(targetEmails)}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
            window.location.href = mailtoUrl;
            showToast(`Abriendo cliente de correo para enviar alerta a ${targetEmails}...`, 'success');
        }

        function openAutomationModal() {
            document.getElementById('automation-modal').classList.remove('hidden');
            if (window.lucide) {
                lucide.createIcons();
            }
        }

        function closeAutomationModal() {
            document.getElementById('automation-modal').classList.add('hidden');
        }

        function copyAppsScript() {
            const codeText = document.getElementById('apps-script-code').textContent;
            const textarea = document.createElement('textarea');
            textarea.value = codeText;
            textarea.style.position = 'fixed';
            textarea.style.opacity = '0';
            document.body.appendChild(textarea);
            textarea.select();
            try {
                document.execCommand('copy');
                showToast('¡Código unificado de Google Apps Script copiado!', 'success');
            } catch (err) {
                showToast('No se pudo copiar automáticamente. Selecciónalo manualmente.', 'error');
            }
            document.body.removeChild(textarea);
        }

        // --- UTILIDADES DE CÁLCULO DE FECHAS Y EDAD ---
        function formatDateToISO(date) {
            const y = date.getFullYear();
            const m = String(date.getMonth() + 1).padStart(2, '0');
            const d = String(date.getDate()).padStart(2, '0');
            return `${y}-${m}-${d}`;
        }

        function calculateAgeOnDate(birthDate, targetDate) {
            let years = targetDate.getFullYear() - birthDate.getFullYear();
            let months = targetDate.getMonth() - birthDate.getMonth();
            if (targetDate.getDate() < birthDate.getDate()) {
                months--;
            }
            if (months < 0) {
                years--;
                months += 12;
            }
            return { years: Math.max(0, years), months: Math.max(0, months) };
        }

        function getDaysUntilNextBirthday(dobIso, fromDate) {
            const [, m, d] = dobIso.split('-').map(Number);
            const start = new Date(fromDate.getFullYear(), fromDate.getMonth(), fromDate.getDate());
            let nextBday = new Date(start.getFullYear(), m - 1, d);
            if (nextBday < start) {
                nextBday = new Date(start.getFullYear() + 1, m - 1, d);
            }
            const diffMs = nextBday - start;
            return Math.round(diffMs / (1000 * 60 * 60 * 24));
        }

        function getGeneration(year) {
            if (year >= 2013) return 'Generación Alfa';
            if (year >= 1997) return 'Generación Z';
            if (year >= 1981) return 'Millennial';
            if (year >= 1965) return 'Generación X';
            if (year >= 1946) return 'Baby Boomer';
            return 'Generación Silenciosa';
        }

        function escapeHtml(str) {
            const div = document.createElement('div');
            div.textContent = str;
            return div.innerHTML;
        }

        // --- NOTIFICACIONES TOAST ---
        function showToast(message, type = 'info') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');

            const styles = {
                success: 'bg-slate-900 text-white border-emerald-500/40',
                error: 'bg-rose-600 text-white border-rose-400',
                info: 'bg-slate-800 text-white border-slate-700'
            };

            const icons = {
                success: 'check-circle-2',
                error: 'alert-circle',
                info: 'info'
            };

            toast.className = `pointer-events-auto flex items-center gap-3 px-4 py-3 rounded-2xl shadow-xl border text-xs sm:text-sm font-medium transition-all transform translate-y-2 opacity-0 ${styles[type] || styles.info}`;
            toast.innerHTML = `
                <i data-lucide="${icons[type] || 'info'}" class="w-4 h-4 shrink-0"></i>
                <span class="flex-1">${escapeHtml(message)}</span>
            `;

            container.appendChild(toast);
            if (window.lucide) {
                lucide.createIcons();
            }

            requestAnimationFrame(() => {
                toast.classList.remove('translate-y-2', 'opacity-0');
            });

            setTimeout(() => {
                toast.classList.add('opacity-0', 'translate-y-2');
                setTimeout(() => toast.remove(), 300);
            }, 3500);
        }
    </script>
</body>
</html>
